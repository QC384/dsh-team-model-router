{
  "name": "dsh-team-model-router",
  "version": "0.3.0",
  "description": "Per-task model switching plus /team-model command and settings card for DSH Agent Teams.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "subagent",
    "model-routing"
  ],
  "dsh": {
    "bundle": {
