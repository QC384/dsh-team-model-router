    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.1",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT"
}
